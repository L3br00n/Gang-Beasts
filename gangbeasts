<!DOCTYPE html>
<html lang="en-us">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
    <title>Unity WebGL Player | Gang Beasts</title>
    <style>
      html, body {
        width: 100%;
        height: 100%;
        margin: 0;
        padding: 0;
        overflow: hidden;
        background: #111;
        color: #fff;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      }
      #unity-container {
        width: 100%;
        height: 100%;
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      #unity-canvas {
        background: #231F20;
        width: 100%;
        height: 100%;
        display: block;
      }
      #unity-loading-bar {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        display: none;
        text-align: center;
        width: 380px;
        max-width: 90vw;
      }
      #unity-progress-bar-empty {
        width: 100%;
        height: 14px;
        margin-top: 15px;
        background: rgba(255, 255, 255, 0.15);
        border-radius: 7px;
        overflow: hidden;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, 0.5);
      }
      #unity-progress-bar-full {
        width: 0%;
        height: 100%;
        background: #4caf50;
        border-radius: 7px;
        transition: width 0.15s ease;
      }
      #unity-loading-chunk {
        margin-top: 12px;
        font-size: 13px;
        font-weight: 500;
        color: #eee;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      #unity-loading-details {
        margin-top: 6px;
        font-size: 12px;
        color: #888;
        font-family: monospace;
      }
      #unity-mobile-warning {
        position: absolute;
        top: 10px;
        left: 50%;
        transform: translateX(-50%);
        background: rgba(200, 40, 40, 0.85);
        padding: 8px 16px;
        border-radius: 4px;
        display: none;
        font-size: 14px;
        z-index: 10;
      }
      #unity-error-banner {
        position: absolute;
        top: 20px;
        left: 50%;
        transform: translateX(-50%);
        background: #8b0000;
        border: 1px solid #ff4d4d;
        color: #fff;
        padding: 10px 16px;
        border-radius: 6px;
        font-size: 13px;
        max-width: 90vw;
        display: none;
        z-index: 20;
        white-space: pre-wrap;
      }
      #unity-footer {
        position: absolute;
        bottom: 10px;
        right: 15px;
        display: flex;
        align-items: center;
        gap: 12px;
        z-index: 5;
      }
      #unity-fullscreen-button {
        cursor: pointer;
        background: rgba(0, 0, 0, 0.6);
        border: 1px solid #444;
        border-radius: 4px;
        padding: 6px 12px;
        font-size: 12px;
        color: #eee;
        user-select: none;
      }
      #unity-fullscreen-button:hover {
        background: rgba(255, 255, 255, 0.1);
      }

      @import url('https://fonts.googleapis.com/css2?family=Bangers&family=Permanent+Marker&family=Inter:wght@400;500;600;700;800;900&display=swap');

      :root { color-scheme: dark; }
      body { background: #080808; font-family: 'Inter', sans-serif; }
      #unity-canvas {
        opacity: 0;
        transform: scale(1.025);
        transition: opacity 1.15s cubic-bezier(.2,.75,.2,1), transform 1.5s cubic-bezier(.16,1,.3,1);
      }
      #unity-container.game-ready #unity-canvas { opacity: 1; transform: scale(1); }
      #unity-loading-bar {
        z-index: 5;
        width: min(390px, 82vw);
        padding: 25px;
        border: 0;
        border-radius: 0;
        background: rgba(0,0,0,.38);
        backdrop-filter: blur(3px);
        -webkit-backdrop-filter: blur(3px);
        box-shadow: none;
        opacity: 0;
        transform: translate(-50%, calc(-50% + 12px));
        transition: opacity .55s ease, transform .7s cubic-bezier(.2,.8,.2,1);
      }
      #unity-loading-bar.visible {
        opacity: 1;
        transform: translate(-50%, -50%);
      }
      #unity-loading-bar h2 {
        font-family: 'Permanent Marker', Impact, sans-serif;
        letter-spacing: .02em;
        text-transform: uppercase;
        transform: rotate(-2deg);
        font-size: 25px !important;
        text-shadow: 0 3px 22px rgba(255,255,255,.14);
      }
      #unity-progress-bar-empty {
        height: 4px;
        margin-top: 18px;
        background: rgba(255,255,255,.24);
        border-radius: 0;
        box-shadow: none;
      }
      #unity-progress-bar-full {
        background: #e7ff3f;
        border-radius: 0;
        transition: width .42s cubic-bezier(.22,1,.36,1);
        box-shadow: none;
      }
      #unity-loading-chunk { margin-top: 17px; color: #f4f4f4; font-size: 12px; letter-spacing: .02em; }
      #unity-loading-details { color: #888; font-family: 'Inter', sans-serif; font-size: 11px; }
      #unity-footer { z-index: 8; }
      #unity-fullscreen-button {
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 999px;
        padding: 9px 15px;
        background: rgba(0,0,0,.45);
        backdrop-filter: blur(12px);
        transition: background .25s ease, border-color .25s ease, transform .25s ease;
      }
      #unity-fullscreen-button:hover {
        background: rgba(255,255,255,.13);
        border-color: rgba(255,255,255,.5);
        transform: translateY(-1px);
      }
      #splash-screen {
        position: absolute;
        inset: 0;
        z-index: 4;
        display: grid;
        place-items: center;
        overflow: hidden;
        background: #101010;
        opacity: 1;
        visibility: visible;
        transition: opacity 1s cubic-bezier(.2,.75,.2,1), visibility 1s;
      }
      #splash-screen::before {
        content: "";
        position: absolute;
        inset: -22px;
        background: url('https://wallpapers.com/images/featured/gang-beast-h58e21uc3j392z7r.jpg') center 43% / cover no-repeat;
        filter: blur(2px) brightness(.55) saturate(1.18) contrast(1.08);
        transform: scale(1.04) rotate(-.5deg);
        animation: backdrop-drift 22s ease-in-out infinite alternate;
      }
      #splash-screen::after {
        content: "";
        position: absolute;
        inset: 0;
        background:
          linear-gradient(180deg, rgba(0,0,0,.08), rgba(0,0,0,.12) 38%, rgba(0,0,0,.72)),
          radial-gradient(ellipse at center, transparent 0%, rgba(0,0,0,.28) 100%);
        pointer-events: none;
      }
      #splash-screen.leaving { opacity: 0; visibility: hidden; pointer-events: none; }
      .splash-content {
        position: relative;
        z-index: 1;
        width: min(560px, 88vw);
        padding: 32px 22px;
        text-align: center;
        transform: rotate(-1deg);
        animation: splash-rise .75s cubic-bezier(.2,.8,.2,1) both;
      }
      .splash-kicker {
        display: inline-block;
        margin: 0 0 14px;
        padding: 6px 10px 4px;
        color: #111;
        background: transparent;
        font-family: 'Permanent Marker', cursive;
        font-size: 15px;
        letter-spacing: .01em;
        text-transform: uppercase;
        transform: rotate(-7deg) skew(-5deg);
      }
      .splash-title {
        margin: 0;
        color: #fff;
        font-family: 'Bangers', Impact, sans-serif;
        font-size: clamp(70px, 14vw, 132px);
        line-height: .88;
        letter-spacing: .025em;
        text-transform: uppercase;
        -webkit-text-stroke: 1px rgba(0,0,0,.6);
        text-shadow: 5px 5px 0 #ed4c2f, -3px -2px 0 #e7ff3f, 8px 10px 0 rgba(0,0,0,.7);
        transform: rotate(-3deg) skew(-2deg);
      }
      .splash-subtitle {
        margin: 23px 0 30px;
        color: #fff;
        font-family: 'Permanent Marker', cursive;
        font-size: 13px;
        letter-spacing: .025em;
        text-shadow: 2px 2px 0 rgba(0,0,0,.7);
        transform: rotate(1deg);
      }
      #start-game {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 13px;
        min-width: 0;
        padding: 8px 12px;
        overflow: hidden;
        border: 0;
        border-radius: 0;
        color: #fff;
        background: transparent;
        font: 34px 'Permanent Marker', cursive;
        letter-spacing: .02em;
        text-transform: uppercase;
        cursor: pointer;
        text-shadow: 3px 3px 0 #e43d2f, -2px -2px 0 #111;
        transition: transform .14s ease, color .14s ease;
        animation: button-in .65s .12s cubic-bezier(.2,.8,.2,1) both;
      }
      #start-game::before { content: none; }
      #start-game:hover { transform: rotate(-3deg) scale(1.08); color: #e7ff3f; }
      #start-game:hover::before { transform: translateX(130%); }
      #start-game:active { transform: rotate(2deg) scale(.96); }
      #start-game:focus-visible { outline: 2px solid white; outline-offset: 5px; }
      #start-game:disabled { cursor: wait; opacity: .75; }
      .start-arrow { font-size: 16px; line-height: 10px; transition: transform .3s ease; }
      #start-game:hover .start-arrow { transform: translateX(4px); }
      .splash-content::before {
        content: "SMASH!!";
        position: absolute;
        top: -15px;
        right: 2%;
        color: #e7ff3f;
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(20px, 4vw, 32px);
        letter-spacing: -.04em;
        transform: rotate(11deg);
        text-shadow: 2px 3px 0 #111, 4px 4px 0 #e43d2f;
      }
      .splash-content::after {
        content: "BAM!";
        position: absolute;
        left: -2%;
        bottom: 23%;
        color: #e43d2f;
        font-family: 'Permanent Marker', cursive;
        font-size: clamp(24px, 4vw, 38px);
        transform: rotate(-13deg);
        text-shadow: 2px 2px 0 #111, -1px -1px 0 #fff;
        pointer-events: none;
      }
      .splash-credit {
        margin: 12px 0 0;
        color: rgba(255,255,255,.88);
        font: 13px 'Permanent Marker', cursive;
        letter-spacing: 0;
        transform: rotate(-2deg);
      }
      .splash-footnote {
        margin: 25px 0 0;
        color: rgba(255,255,255,.82);
        font-family: 'Permanent Marker', cursive;
        font-size: 11px;
        letter-spacing: .025em;
        transform: rotate(2deg);
      }
      #unity-error-banner {
        z-index: 20;
        border-radius: 12px;
        background: rgba(70,0,0,.9);
        backdrop-filter: blur(16px);
      }
      @keyframes splash-rise {
        from { opacity: 0; transform: translateY(16px) rotate(2deg) scale(.96); filter: blur(3px); }
        to { opacity: 1; transform: translateY(0) rotate(-1deg) scale(1); filter: blur(0); }
      }
      @keyframes button-in {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
      }
      @keyframes backdrop-drift {
        from { transform: scale(1.04) translate3d(-.5%, -.4%, 0); }
        to { transform: scale(1.12) translate3d(.5%, .4%, 0); }
      }
      @media (max-width: 600px) {
        #splash-screen::before { filter: blur(4px) brightness(.4) saturate(.78); }
        .splash-subtitle { font-size: 10px; line-height: 1.7; }
        #unity-loading-bar { padding: 21px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: .01ms !important; }
      }

    </style>
  </head>
  <body>
    <div id="unity-error-banner"></div>
    <div id="unity-container">
      <canvas id="unity-canvas" tabindex="-1"></canvas>
      <section id="splash-screen" aria-label="Gang Beasts start screen">
        <div class="splash-content">
          <p class="splash-kicker">Welcome to the arena</p>
          <h1 class="splash-title">Gang Beasts</h1>
          <p class="splash-subtitle">Wobbly fighters. Unpredictable chaos.</p>
          <button id="start-game" type="button">
            <span>Load game</span><span class="start-arrow" aria-hidden="true">↗</span>
          </button>
          <p class="splash-footnote">CLICK TO ENTER THE FIGHT</p>
          <p class="splash-credit">Thanks to Fernandes for the port</p>
        </div>
      </section>
      <div id="unity-loading-bar">
        <h2 style="margin: 0; font-size: 20px;">Gang Beasts</h2>
        <div id="unity-progress-bar-empty">
          <div id="unity-progress-bar-full"></div>
        </div>
        <div id="unity-loading-chunk">Connecting to CDN...</div>
        <div id="unity-loading-details">0.0 MB / 0.0 MB (0%)</div>
      </div>
      <div id="unity-mobile-warning">
        WebGL builds are not supported on mobile devices.
      </div>
      <div id="unity-footer">
        <div id="unity-fullscreen-button">Fullscreen</div>
      </div>
    </div>

    <script>
      const COMMIT_REF = "0a620ab";
      const REPO_PATH = "AlexBoops/GangBeast-WebPort";

      // Primary CDN and Fallback CDN Mirrors
      const CDN_BASES = [
        `https://cdn.jsdelivr.net/gh/${REPO_PATH}@${COMMIT_REF}/`,
        `https://raw.githubusercontent.com/${REPO_PATH}/${COMMIT_REF}/`,
        `https://cdn.jsdelivr.net/gh/${REPO_PATH}@main/`,
        `https://raw.githubusercontent.com/${REPO_PATH}/main/`
      ];

      const container = document.querySelector("#unity-container");
      const canvas = document.querySelector("#unity-canvas");
      const loadingBar = document.querySelector("#unity-loading-bar");
      const progressBarFull = document.querySelector("#unity-progress-bar-full");
      const loadingChunkEl = document.querySelector("#unity-loading-chunk");
      const loadingDetailsEl = document.querySelector("#unity-loading-details");
      const fullscreenButton = document.querySelector("#unity-fullscreen-button");
      const splashScreen = document.querySelector("#splash-screen");
      const startButton = document.querySelector("#start-game");
      const mobileWarning = document.querySelector("#unity-mobile-warning");
      const errorBanner = document.querySelector("#unity-error-banner");

      function showError(msg) {
        console.error(msg);
        if (errorBanner) {
          errorBanner.textContent = msg;
          errorBanner.style.display = "block";
          if (startButton) {
            startButton.disabled = false;
            startButton.querySelector("span").textContent = "Try again";
            splashScreen.classList.remove("leaving");
            loadingBar.classList.remove("visible");
          }
        }
      }

      function fmtMB(bytes) {
        return (bytes / (1024 * 1024)).toFixed(1) + " MB";
      }

      if (/iPhone|iPad|iPod|Android/i.test(navigator.userAgent)) {
        mobileWarning.style.display = "block";
        setTimeout(() => { mobileWarning.style.display = "none"; }, 5000);
      }

      function sleep(ms) {
        return new Promise(r => setTimeout(r, ms));
      }

      // Tries multiple CDN mirrors if jsDelivr throws 404/403/429
      async function fetchBufferWithMirrors(relativePath) {
        let lastError = null;

        for (let b = 0; b < CDN_BASES.length; b++) {
          const fullUrl = CDN_BASES[b] + relativePath;
          for (let attempt = 1; attempt <= 2; attempt++) {
            try {
              const res = await fetch(attempt === 1 ? fullUrl : `${fullUrl}?t=${Date.now()}`);
              if (res.ok) {
                return await res.arrayBuffer();
              }
              if (res.status === 404 && b < CDN_BASES.length - 1) {
                // If 404, move straight to the fallback mirror
                break;
              }
            } catch (e) {
              lastError = e;
              await sleep(250 * attempt);
            }
          }
        }
        throw new Error(`Failed to load: ${relativePath} across all CDN mirrors.`);
      }

      // Download and merge parts with detailed per-chunk status and byte counters
      async function downloadAndMergePartsWithDetails(relativePaths, labelPrefix, totalTargetBytesHint, onChunkProgress) {
        let buffers = [];
        let loadedBytes = 0;
        const totalParts = relativePaths.length;

        for (let i = 0; i < totalParts; i++) {
          const relPath = relativePaths[i];
          const fileName = relPath.substring(relPath.lastIndexOf("/") + 1);

          loadingChunkEl.textContent = `[${labelPrefix}] Loading ${fileName} (${i + 1}/${totalParts})`;

          const buf = await fetchBufferWithMirrors(relPath);
          buffers.push(new Uint8Array(buf));
          loadedBytes += buf.byteLength;

          const effectiveTotal = Math.max(totalTargetBytesHint, loadedBytes);
          const percent = Math.min(100, (loadedBytes / effectiveTotal) * 100);

          loadingDetailsEl.textContent = `${fmtMB(loadedBytes)} / ${fmtMB(effectiveTotal)} (${percent.toFixed(0)}%)`;

          if (onChunkProgress) {
            onChunkProgress(loadedBytes, effectiveTotal, (i + 1) / totalParts);
          }
          await sleep(15);
        }

        const merged = new Uint8Array(loadedBytes);
        let offset = 0;
        for (const b of buffers) {
          merged.set(b, offset);
          offset += b.length;
        }
        return URL.createObjectURL(new Blob([merged], { type: "application/octet-stream" }));
      }

      function cleanRelativePath(p) {
        if (!p) return "";
        let path = typeof p === "string" ? p : (p.path || p.file || p.url || p.name || "");
        return path.replace(/^https?:\/\/[^\/]+\/[^\/]+\/[^\/]+(\/raw\/[^\/]+|\/gh\/[^\/]+@[^\/]+)?\//, '')
                   .replace(/^\/+/, '');
      }

      // 1. Load 20 Data Chunks
      async function loadGameDataMerged(onProgress) {
        let relPaths = [];

        try {
          const res = await fetch(CDN_BASES[0] + "Build/data-manifest.json");
          if (res.ok) {
            const manifest = await res.json();
            const list = Array.isArray(manifest.parts) ? manifest.parts : (Array.isArray(manifest.files) ? manifest.files : (Array.isArray(manifest) ? manifest : []));
            for (const item of list) {
              const cleaned = cleanRelativePath(item);
              if (cleaned) relPaths.push(cleaned);
            }
          }
        } catch (e) {
          console.warn("Could not read data-manifest.json, using fallback chunk list:", e);
        }

        // Direct fallback: 20 parts (part-000.bin through part-019.bin)
        if (relPaths.length === 0) {
          for (let i = 0; i < 20; i++) {
            const idx = String(i).padStart(3, '0');
            relPaths.push(`Build/data-e4a1c7a5d457/part-${idx}.bin`);
          }
        }

        const dataSizeHint = 400 * 1024 * 1024;
        return await downloadAndMergePartsWithDetails(relPaths, "DATA", dataSizeHint, onProgress);
      }

      // 2. Load 4 WASM Chunks
      async function loadWasmMerged(onProgress) {
        const wasmPaths = [
          "Build/WebGLValidation.wasm.part1",
          "Build/WebGLValidation.wasm.part2",
          "Build/WebGLValidation.wasm.part3",
          "Build/WebGLValidation.wasm.part4"
        ];
        const wasmSizeHint = 50 * 1024 * 1024;
        return await downloadAndMergePartsWithDetails(wasmPaths, "WASM", wasmSizeHint, onProgress);
      }

      async function bootGangBeasts() {
        if (startButton.disabled) return;
        startButton.disabled = true;
        startButton.querySelector("span").textContent = "Loading...";
        splashScreen.classList.add("leaving");
        container.classList.add("game-starting");
        loadingBar.style.display = "block";
        requestAnimationFrame(() => loadingBar.classList.add("visible"));

        let dataBlobUrl = null;
        let wasmBlobUrl = null;

        try {
          // Phase 1: Download & Merge 20 Data chunks (0% -> 55% overall progress)
          dataBlobUrl = await loadGameDataMerged((loaded, total, ratio) => {
            progressBarFull.style.width = (ratio * 55).toFixed(1) + "%";
          });

          // Phase 2: Download & Merge 4 WASM chunks (55% -> 80% overall progress)
          wasmBlobUrl = await loadWasmMerged((loaded, total, ratio) => {
            progressBarFull.style.width = (55 + ratio * 25).toFixed(1) + "%";
          });

          // Phase 3: Setup Unity Engine Configuration
          loadingChunkEl.textContent = "Configuring Unity engine...";
          loadingDetailsEl.textContent = "Decompressing and preparing memory...";
          progressBarFull.style.width = "82%";

          const config = {
            dataUrl: dataBlobUrl,
            frameworkUrl: CDN_BASES[0] + "Build/WebGLValidation.framework.js",
            codeUrl: wasmBlobUrl,
            streamingAssetsUrl: CDN_BASES[0] + "StreamingAssets",
            companyName: "Boneloaf",
            productName: "Gang Beasts",
            productVersion: "1.0",
          };

          // Phase 4: Inject Unity Loader
          const loaderBuf = await fetchBufferWithMirrors("Build/WebGLValidation.loader.js");
          const loaderBlob = new Blob([loaderBuf], { type: "application/javascript" });
          const loaderUrl = URL.createObjectURL(loaderBlob);

          const loaderScript = document.createElement("script");
          loaderScript.src = loaderUrl;

          loaderScript.onload = () => {
            loadingChunkEl.textContent = "Booting WebGL...";
            createUnityInstance(canvas, config, (progress) => {
              progressBarFull.style.width = (82 + progress * 18).toFixed(1) + "%";
              loadingDetailsEl.textContent = `Compiling shaders & assets (${(progress * 100).toFixed(0)}%)`;
            }).then((unityInstance) => {
              loadingBar.classList.remove("visible");
              container.classList.add("game-ready");
              setTimeout(() => { loadingBar.style.display = "none"; }, 600);
              fullscreenButton.onclick = () => {
                unityInstance.SetFullscreen(1);
              };
            }).catch((err) => {
              showError("Engine boot failed: " + err.message);
            });
          };

          loaderScript.onerror = () => {
            showError("Failed to initialize WebGLValidation.loader.js");
          };

          document.body.appendChild(loaderScript);
        } catch (err) {
          showError("Could not load Gang Beasts:\n" + err.message);
        }
      }

      startButton.addEventListener("click", bootGangBeasts);
    </script>
  </body>
</html>
